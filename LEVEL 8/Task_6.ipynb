      "source": [
        "import numpy as np"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "n=1\n",
        "p=0.3\n",
        "size=1000"
      ],
      "metadata": {
        "id": "3zLY6WPoEDm8"
      },
      "execution_count": 30,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "trail1=np.random.binomial(n,p,size)\n",
        "trail1\n",
        "success_probability=trail1.mean()\n",
        "print(f\"Simulated P = {success_probability:.3f}\")\n",
        "print(f\"Matches theoretical P = {p:.3f} for Bernoulli trial.\")"
      ],
